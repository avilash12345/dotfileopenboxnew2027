#!/bin/bash
ROFI_THEME="$HOME/.config/rofi/powermenu.rasi"

confirm() {
  ANS=$(printf " Yes\n No" | rofi -dmenu -i -p "Sure to $1?" -theme "$ROFI_THEME")
  [[ "$ANS" == *"Yes"* ]] && return 0 || exit 0
}

CHOICE=$(printf "  Shutdown\n  Reboot\n  Logout\n  Lock\n  Suspend" | rofi -dmenu -i -p " Power Menu" -theme "$ROFI_THEME")

case "$CHOICE" in
  *Shutdown) confirm "Shutdown" && systemctl poweroff ;;
  *Reboot)   confirm "Reboot" && systemctl reboot ;;
  *Logout)   confirm "Logout" && openbox --exit ;;
  *Lock)     i3lock -c 1e1e2e -n --clock --indicator ;;
  *Suspend)  confirm "Suspend" && systemctl suspend ;;
esac
