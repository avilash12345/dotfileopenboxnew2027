* {
    bg: #1e1e2ee6;
    bg-alt: #313244;
    fg: #cdd6f4;
    fg-alt: #6c7086;
    accent: #89b4fa;
    red: #f38ba8;
    green: #a6e3a1;
    yellow: #f9e2af;

    font: "JetBrainsMono Nerd Font Bold 11";
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 16px;
    width: 320px;
    padding: 20px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 15px;
}

inputbar {
    children: [ prompt, textbox-prompt-colon, entry ];
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 10px 15px;
}

prompt {
    background-color: transparent;
    text-color: @accent;
}

textbox-prompt-colon {
    expand: false;
    str: " ";
    text-color: @fg;
    background-color: transparent;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder-color: @fg-alt;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 5;
    spacing: 8px;
    scrollbar: false;
    dynamic: false;
}

element {
    background-color: @bg-alt;
    text-color: @fg;
    border-radius: 10px;
    padding: 12px 15px;
}

element selected {
    background-color: @accent;
    text-color: #1e1e2e;
    border: 0px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
